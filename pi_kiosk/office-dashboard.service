[Unit]
Description=Office Dashboard Flask App
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/cherry-dene-dashboard
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/pi/cherry-dene-dashboard/dashboard_server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
